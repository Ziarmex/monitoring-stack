[
  {
    "id": "main_flow",
    "type": "tab",
    "label": "Monitoring Industriel",
    "disabled": false,
    "info": "Flux principal de collecte et traitement des données capteurs"
  },
  {
    "id": "mqtt_in_temp",
    "type": "mqtt in",
    "z": "main_flow",
    "name": "Temperature",
    "topic": "sensors/temperature/#",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker",
    "x": 120,
    "y": 260,
    "wires": [["validate_data"]]
  },
  {
    "id": "mqtt_in_pressure",
    "type": "mqtt in",
    "z": "main_flow",
    "name": "Pressure",
    "topic": "sensors/pressure/#",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker",
    "x": 120,
    "y": 180,
    "wires": [["validate_data"]]
  },
  {
    "id": "mqtt_in_humidity",
    "type": "mqtt in",
    "z": "main_flow",
    "name": "Humidity",
    "topic": "sensors/humidity/#",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker",
    "x": 120,
    "y": 260,
    "wires": [["validate_data"]]
  },
  {
    "id": "validate_data",
    "type": "function",
    "z": "main_flow",
    "name": "Validate & Transform",
    "func": "const data = msg.payload;\n\nif (!data || data.value === undefined || !data.type) {\n    node.warn('Données invalides reçues');\n    return null;\n}\n\nmsg.original = data;\n\nconst value = parseFloat(data.value);\nconst timestamp = new Date(data.timestamp).getTime() * 1000000;\n\nmsg.url = 'http://influxdb:8086/api/v2/write?org=industrial&bucket=sensors';\nmsg.headers = { 'Authorization': 'Token my-super-secret-auth-token' };\nmsg.payload = `${data.type},sensor_id=${data.sensor_id},unit=${data.unit} value=${value},alert=${data.alert ? 1 : 0} ${timestamp}`;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 530,
    "y": 180,
    "wires": [["influxdb_write", "check_alert"]]
  },
  {
    "id": "check_alert",
    "type": "switch",
    "z": "main_flow",
    "name": "Check Alert",
    "property": "original.alert",
    "propertyType": "msg",
    "rules": [
      {
        "t": "true"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 1,
    "x": 750,
    "y": 100,
    "wires": [["alert_debug", "alert_format"]]
  },
  {
    "id": "alert_format",
    "type": "function",
    "z": "main_flow",
    "name": "Format Alert",
    "func": "const data = msg.original;\n\nmsg.payload = {\n    title: `🚨 ALERTE ${data.type.toUpperCase()}`,\n    message: `Le capteur ${data.sensor_id} a dépassé le seuil: ${data.value} ${data.unit}`,\n    timestamp: data.timestamp,\n    severity: 'warning'\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 970,
    "y": 100,
    "wires": [["alert_debug_formatted"]]
  },
  {
    "id": "alert_debug",
    "type": "debug",
    "z": "main_flow",
    "name": "Alert Raw",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "original",
    "targetType": "msg",
    "x": 950,
    "y": 60,
    "wires": []
  },
  {
    "id": "alert_debug_formatted",
    "type": "debug",
    "z": "main_flow",
    "name": "Alert Formatted",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 1180,
    "y": 100,
    "wires": []
  },
  {
    "id": "influxdb_write",
    "type": "http request",
    "z": "main_flow",
    "name": "Write to InfluxDB",
    "method": "POST",
    "ret": "txt",
    "url": "",
    "tls": "",
    "proxy": "",
    "authType": "",
    "x": 750,
    "y": 180,
    "wires": []
  },
  {
    "id": "data_debug",
    "type": "debug",
    "z": "main_flow",
    "name": "Data Flow",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "targetType": "full",
    "x": 760,
    "y": 260,
    "wires": []
  },
  {
    "id": "mqtt_broker",
    "type": "mqtt-broker",
    "name": "Mosquitto",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "willMsg": {},
    "userProps": "",
    "sessionExpiry": ""
  }
]