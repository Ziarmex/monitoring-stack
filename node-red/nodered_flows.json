[
  {
    "id": "main_flow",
    "type": "tab",
    "label": "Monitoring Industriel",
    "disabled": false,
    "info": "Flux principal de collecte et traitement des données capteurs"
  },
  {
    "id": "mqtt_in_temp",
    "type": "mqtt in",
    "z": "main_flow",
    "name": "Temperature",
    "topic": "sensors/temperature/#",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker",
    "x": 120,
    "y": 100,
    "wires": [["parse_json"]]
  },
  {
    "id": "mqtt_in_pressure",
    "type": "mqtt in",
    "z": "main_flow",
    "name": "Pressure",
    "topic": "sensors/pressure/#",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker",
    "x": 120,
    "y": 180,
    "wires": [["parse_json"]]
  },
  {
    "id": "mqtt_in_humidity",
    "type": "mqtt in",
    "z": "main_flow",
    "name": "Humidity",
    "topic": "sensors/humidity/#",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt_broker",
    "x": 120,
    "y": 260,
    "wires": [["parse_json"]]
  },
  {
    "id": "parse_json",
    "type": "json",
    "z": "main_flow",
    "name": "Parse JSON",
    "property": "payload",
    "action": "",
    "x": 320,
    "y": 180,
    "wires": [["validate_data"]]
  },
  {
    "id": "validate_data",
    "type": "function",
    "z": "main_flow",
    "name": "Validate & Transform",
    "func": "// Validation des données\nif (!msg.payload || !msg.payload.value || !msg.payload.type) {\n    node.warn('Données invalides reçues');\n    return null;\n}\n\n// Transformation pour InfluxDB\nconst data = msg.payload;\n\nmsg.payload = {\n    measurement: data.type,\n    fields: {\n        value: parseFloat(data.value),\n        alert: data.alert ? 1 : 0\n    },\n    tags: {\n        sensor_id: data.sensor_id,\n        unit: data.unit\n    },\n    timestamp: new Date(data.timestamp).getTime() * 1000000\n};\n\n// Stocker les données originales pour les alertes\nmsg.original = data;\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 530,
    "y": 180,
    "wires": [["check_alert", "influx_out"]]
  },
  {
    "id": "check_alert",
    "type": "switch",
    "z": "main_flow",
    "name": "Check Alert",
    "property": "original.alert",
    "propertyType": "msg",
    "rules": [
      {
        "t": "true"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 1,
    "x": 750,
    "y": 100,
    "wires": [["alert_debug", "alert_format"]]
  },
  {
    "id": "alert_format",
    "type": "function",
    "z": "main_flow",
    "name": "Format Alert",
    "func": "const data = msg.original;\n\nmsg.payload = {\n    title: `🚨 ALERTE ${data.type.toUpperCase()}`,\n    message: `Le capteur ${data.sensor_id} a dépassé le seuil: ${data.value} ${data.unit}`,\n    timestamp: data.timestamp,\n    severity: 'warning'\n};\n\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 970,
    "y": 100,
    "wires": [["alert_debug_formatted"]]
  },
  {
    "id": "alert_debug",
    "type": "debug",
    "z": "main_flow",
    "name": "Alert Raw",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "original",
    "targetType": "msg",
    "x": 950,
    "y": 60,
    "wires": []
  },
  {
    "id": "alert_debug_formatted",
    "type": "debug",
    "z": "main_flow",
    "name": "Alert Formatted",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "x": 1180,
    "y": 100,
    "wires": []
  },
  {
    "id": "influx_out",
    "type": "influxdb out",
    "z": "main_flow",
    "influxdb": "influxdb_config",
    "name": "Write to InfluxDB",
    "measurement": "",
    "precision": "ns",
    "retentionPolicy": "",
    "x": 790,
    "y": 180,
    "wires": []
  },
  {
    "id": "data_debug",
    "type": "debug",
    "z": "main_flow",
    "name": "Data Flow",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "targetType": "full",
    "x": 760,
    "y": 260,
    "wires": []
  },
  {
    "id": "mqtt_broker",
    "type": "mqtt-broker",
    "name": "Mosquitto",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "birthMsg": {},
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "closeMsg": {},
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "willMsg": {},
    "userProps": "",
    "sessionExpiry": ""
  },
  {
    "id": "influxdb_config",
    "type": "influxdb",
    "hostname": "influxdb",
    "port": "8086",
    "protocol": "http",
    "database": "sensors",
    "name": "InfluxDB",
    "usetls": false,
    "tls": "",
    "influxdbVersion": "2.0",
    "url": "http://influxdb:8086",
    "timeout": "10",
    "rejectUnauthorized": true
  }
]